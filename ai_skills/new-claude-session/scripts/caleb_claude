#!/usr/bin/env bash
# caleb_claude — launch Claude Code with permissions skipped and Remote Control,
# wrapped in a tmux session so it survives an SSH drop / phone sleep. Detach with
# C-b d; reattach with `tmux attach -t <name>` (see `tmux ls`).
# Remote Control prints a claude.ai/code/session_… link on its `/rc active` line,
# so the session is also steerable from the phone / Claude app.
# Any extra args (e.g. an initial prompt) pass straight through to claude —
# except that under --detach an opening prompt is typed in with send-keys once
# the bridge is up, because claude drops a positional prompt under
# --remote-control. CC_PROMPT=... sets one without any guessing.
# Also invocable as `cclaude`.
#
# Set CC_REPO below and a launch from $HOME starts the session there instead,
# because CLAUDE.md is only read from the directory claude actually starts in —
# point it at the repo whose CLAUDE.md describes the machine and every new
# session comes up knowing where it is. CC_CWD=/path starts somewhere else;
# CC_CWD=. stays exactly where you are. Resuming is exempt — a conversation
# keeps its own cwd.
#
# Each bare launch spins up its own session, so you can run several at once:
#   caleb_claude          -> caleb_claude, then caleb_claude-2, -3, ... as needed
# Pin/reattach a named one instead with CC_SESSION:
#   CC_SESSION=vpn caleb_claude   -> attaches to "vpn" if it exists, else creates it
#
#   caleb_claude --detach [args]  -> spawn DETACHED, print the session name and
#                                the claude.ai/code link, and return. This is the
#                                mode for Claude itself: from inside a session
#                                $TMUX is set, so a bare `caleb_claude` would exec
#                                claude into a pipe with no TTY instead of
#                                creating anything. --detach is also the only
#                                mode that is safe to call from a script.
#
# If you keep an always-on session, it is managed by cron via
# caleb_claude_ensure — these manual sessions never collide with it.
set -euo pipefail

DETACH=0
case "${1:-}" in
    --detach|-d) DETACH=1; shift ;;
esac

# Absolute path, not bare `claude`. tmux runs the command below through
# `/bin/sh -c`, which is neither login nor interactive, so it does not read
# .bashrc and would not find ~/.npm-global/bin. This used to "work" only
# because the stale system-wide /usr/bin/claude (v2.1.71, no --remote-control)
# sat on the default PATH; that copy was removed 2026-08-29.
CLAUDE_BIN="${CC_CLAUDE_BIN:-$HOME/.npm-global/bin/claude}"
[ -x "$CLAUDE_BIN" ] || CLAUDE_BIN="$(command -v claude || echo claude)"
CLAUDE=("$CLAUDE_BIN" --dangerously-skip-permissions --remote-control)

# ---- where the session starts ---------------------------------------------
# claude reads CLAUDE.md from the directory it is started in, and the one that
# explains this machine lives in a repo. A launch from $HOME means "put it
# somewhere sensible", not "here", so that is where it goes — and the session
# comes up already knowing what the box is. Any other cwd is a deliberate
# choice about which project you are in and is left alone. CC_CWD overrides
# either way (CC_CWD=. to stay put), and --resume/--continue are exempt: a
# conversation belongs to the directory it grew up in, which cc-resume.sh has
# already cd'd to.
#
# The fallbacks matter more than the default. An unreadable or never-trusted
# directory does not fail loudly — a detached session there hangs on the trust
# prompt with nobody to answer it and reports NOT ARMED 30 seconds later — so
# check both here and quietly stay put rather than launching into a hole.
# Where $HOME-launched sessions go. Empty = off: launches stay where they were
# called from. Set it to the repo whose CLAUDE.md describes this machine, and
# make sure that directory carries hasTrustDialogAccepted in ~/.claude.json.
CC_REPO="${CC_REPO:-}"

trusted() {
    command -v python3 >/dev/null 2>&1 || return 0   # can't tell; assume the best
    python3 - "$1" <<'PYEOF'
import json, os, sys
try:
    cfg = json.load(open(os.path.expanduser("~/.claude.json")))
except Exception:
    sys.exit(0)                                      # no config to disagree with
p = (cfg.get("projects") or {}).get(sys.argv[1])
sys.exit(0 if p and p.get("hasTrustDialogAccepted") else 1)
PYEOF
}

RESUMING=0
for _a in "$@"; do
    case "$_a" in
        --resume|-r|--continue|-c|--fork-session) RESUMING=1; break ;;
    esac
done

START_DIR=""
if [ -n "${CC_CWD:-}" ]; then
    START_DIR="$CC_CWD"
elif [ "$RESUMING" = 0 ] && [ -n "$CC_REPO" ] && [ "$PWD" = "$HOME" ]; then
    START_DIR="$CC_REPO"
fi
if [ -n "$START_DIR" ]; then
    if ! ABS_DIR="$(cd "$START_DIR" 2>/dev/null && pwd)"; then
        echo "caleb_claude: $START_DIR is not a directory I can enter — staying in $PWD" >&2
    elif [ "$ABS_DIR" != "$PWD" ]; then
        if trusted "$ABS_DIR"; then
            cd "$ABS_DIR"
        else
            echo "caleb_claude: $ABS_DIR has never been trusted in this account, so a" >&2
            echo "              session there would hang on the trust prompt — staying in $PWD." >&2
            echo "              Accept it once attached, or set hasTrustDialogAccepted for it" >&2
            echo "              in ~/.claude.json." >&2
        fi
    fi
fi

# Already inside tmux, or no tmux at all — nesting is a hall of mirrors and a
# missing binary is no reason to refuse. Either way, just run claude directly.
# --detach is exempt: it never wants to become claude, it wants to *start* one
# somewhere else and come back with a link.
if [ "$DETACH" = 0 ] && { [ -n "${TMUX:-}" ] || ! command -v tmux >/dev/null 2>&1; }; then
    exec "${CLAUDE[@]}" "$@"
fi
if [ "$DETACH" = 1 ] && ! command -v tmux >/dev/null 2>&1; then
    echo "caleb_claude: --detach needs tmux, which isn't installed" >&2
    exit 1
fi

if [ -n "${CC_SESSION:-}" ]; then
    # Explicit name: reattach to it if it's already out there, else create it.
    SESSION="$CC_SESSION"
    if tmux has-session -t "$SESSION" 2>/dev/null; then
        exec tmux attach-session -t "$SESSION"
    fi
else
    # No name given: pick the first free caleb_claude[-N] so bare launches stack
    # instead of colliding.
    SESSION="caleb_claude"; n=2
    while tmux has-session -t "$SESSION" 2>/dev/null; do
        SESSION="caleb_claude-$n"; n=$((n + 1))
    done
fi

# Fresh session. Reassemble the command with every arg safely re-quoted, since
# tmux hands the string to /bin/sh -c.
#
# In --detach mode a lone non-flag trailing arg is an opening instruction, and
# claude v2.1.270 SILENTLY DROPS a positional prompt when --remote-control is
# on: the session comes up armed, empty, and waiting, which looks like success
# until you notice nothing happened. Hold it back and type it in with
# send-keys once the bridge is up instead. Flags still pass straight through.
# CC_PROMPT is the unambiguous way to pass one. Otherwise the trailing arg is
# an opening instruction only if it is neither a flag nor the VALUE of one —
# without that second test, `--detach --resume <uuid>` would mistake the uuid
# for a prompt and start an empty session that types its own id at itself.
PROMPT="${CC_PROMPT:-}"
if [ "$DETACH" = 1 ] && [ -z "$PROMPT" ] && [ $# -ge 1 ]; then
    last="${!#}"; prev=""; [ $# -ge 2 ] && prev="${@: -2:1}"
    steal=1
    case "$last" in -*) steal=0 ;; esac
    case "$prev" in -*) steal=0 ;; esac
    if [ "$steal" = 1 ]; then PROMPT="$last"; set -- "${@:1:$#-1}"; fi
fi

CMD="$(printf '%q ' "${CLAUDE[@]}")"
for a in "$@"; do CMD+=" $(printf '%q' "$a")"; done

if [ "$DETACH" = 0 ]; then
    exec tmux new-session -s "$SESSION" "$CMD"
fi

# ---- detached spawn -------------------------------------------------------
SESSIONS_DIR="$HOME/.claude/sessions"

# tmux's #{pane_pid} is the pane's TOP process, which is only claude if every
# wrapper exec'd through. /bin/sh does not always take that optimisation, and
# when it doesn't the pane pid is a surviving `sh -c` with claude as its CHILD —
# so a state file read at the pane pid never exists and an ARMED session reads
# as unarmed. Walk down to the first descendant that owns a state file.
# (Same logic as the keepalive's claude_pid().)
claude_pid() {
    local queue="$1" next p
    while [ -n "${queue// /}" ]; do
        next=""
        for p in $queue; do
            [ -f "$SESSIONS_DIR/$p.json" ] && { printf '%s' "$p"; return 0; }
            next="$next $(pgrep -P "$p" 2>/dev/null | tr '\n' ' ')"
        done
        queue="$next"
    done
    printf '%s' "$1"
}

# -x/-y: a detached tmux session defaults to 80x24 and Claude's UI is cramped in
# it. A keepalive should spawn its always-on session at 220x50 for the same reason.
tmux new-session -d -s "$SESSION" -x 220 -y 50 "$CMD"

# Since v2.1.215 the --remote-control flag arms the bridge on its own within a
# few seconds, even detached (#30447). Poll rather than sleep a flat 30s, and
# deliberately do NOT send `/remote-control` if it times out: that command
# TOGGLES, so nudging a session that armed late would switch a LIVE bridge off.
LINK="" ; PID=""
for _ in $(seq 1 30); do
    sleep 1
    PID="$(claude_pid "$(tmux list-panes -t "$SESSION" -F '#{pane_pid}' 2>/dev/null | head -1)")"
    [ -n "$PID" ] && [ -f "$SESSIONS_DIR/$PID.json" ] || continue
    LINK="$(grep -oE '"bridgeSessionId"[[:space:]]*:[[:space:]]*"session_[A-Za-z0-9]+"' \
        "$SESSIONS_DIR/$PID.json" 2>/dev/null | grep -oE 'session_[A-Za-z0-9]+' | head -1 || true)"
    [ -n "$LINK" ] && break
done

echo "session:  $SESSION"
echo "cwd:      $PWD"
echo "attach:   tmux attach -t $SESSION"
if [ -n "$LINK" ]; then
    echo "link:     https://claude.ai/code/$LINK"
    if [ -n "$PROMPT" ]; then
        # C-u first: claude restores the last unsent draft for a directory
        # into the input box, and send-keys APPENDS, so without this the
        # prompt gets glued onto the tail of whatever someone abandoned there
        # last week and both get submitted as one sentence.
        # Then two calls with a beat between them: a literal string and its
        # Enter sent back to back arrive as one paste, and the TUI puts a line
        # break in the box rather than submitting.
        sleep 2
        tmux send-keys -t "$SESSION" C-u
        sleep 0.3
        tmux send-keys -t "$SESSION" -l -- "$PROMPT"
        sleep 1
        tmux send-keys -t "$SESSION" Enter
        echo "prompt:   sent"
    fi
else
    echo "link:     NOT ARMED after 30s — the process is up but the phone can't"
    echo "          reach it. Look at it first: tmux attach -t $SESSION"
    echo "          Most likely the trust prompt (\"Is this a project you"
    echo "          trust?\") for $(pwd) — a detached session has nobody to"
    echo "          answer it and waits forever. Accept it once in an attached"
    echo "          session, or set hasTrustDialogAccepted for that directory"
    echo "          in ~/.claude.json. Do NOT type /remote-control at it."
    exit 1
fi
