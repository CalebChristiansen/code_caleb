#!/usr/bin/env bash
# lclaude — launch Claude Code with permissions skipped and Remote Control,
# wrapped in a tmux session so it survives an SSH drop / phone sleep. Detach with
# C-b d; reattach with `tmux attach -t <name>` (see `tmux ls`).
# Any extra args (e.g. an initial prompt) pass straight through to claude.
#
# Also invocable as `caleb_claude` / `cclaude`, purely so muscle memory from fi's
# shell lands somewhere instead of on "command not found". The name you type has
# no effect on what runs: this is lunate's account, lunate's credentials, and the
# session is named `lclaude[-N]` whichever alias you came in through.
#
# Each bare launch spins up its own session, so you can run several at once:
#   lclaude          -> lclaude, then lclaude-2, -3, ... as needed
# Pin/reattach a named one instead with CC_SESSION:
#   CC_SESSION=api lclaude   -> attaches to "api" if it exists, else creates it
#
# The always-on session is named `lunate` and is managed by cron via
# lunate_claude_ensure — these manual sessions never collide with it.
#
#   lclaude --detach [args]   -> spawn DETACHED, print the session name and the
#                                claude.ai/code link, and return. This is the
#                                mode for Claude itself: from inside a session
#                                $TMUX is set, so a bare `lclaude` would exec
#                                claude into a pipe with no TTY instead of
#                                creating anything. --detach is also the only
#                                mode that is safe to call from a script.
set -euo pipefail

DETACH=0
case "${1:-}" in
    --detach|-d) DETACH=1; shift ;;
esac

# Absolute path: /usr/bin/claude on this box is v2.1.71 and has no
# --remote-control flag. Never trust PATH for this.
CLAUDE_BIN="${CC_CLAUDE_BIN:-$HOME/.npm-global/bin/claude}"
[ -x "$CLAUDE_BIN" ] || CLAUDE_BIN="$(command -v claude || echo claude)"
CLAUDE=("$CLAUDE_BIN" --dangerously-skip-permissions --remote-control)

# Already inside tmux, or no tmux at all — nesting is a hall of mirrors and a
# missing binary is no reason to refuse. Either way, just run claude directly.
# --detach is exempt: it never wants to become claude, it wants to *start* one
# somewhere else and come back with a link.
if [ "$DETACH" = 0 ] && { [ -n "${TMUX:-}" ] || ! command -v tmux >/dev/null 2>&1; }; then
    exec "${CLAUDE[@]}" "$@"
fi
if [ "$DETACH" = 1 ] && ! command -v tmux >/dev/null 2>&1; then
    echo "lclaude: --detach needs tmux, which isn't installed" >&2
    exit 1
fi

if [ -n "${CC_SESSION:-}" ]; then
    SESSION="$CC_SESSION"
    if tmux has-session -t "$SESSION" 2>/dev/null; then
        exec tmux attach-session -t "$SESSION"
    fi
else
    SESSION="lclaude"; n=2
    while tmux has-session -t "$SESSION" 2>/dev/null; do
        SESSION="lclaude-$n"; n=$((n + 1))
    done
fi

# Fresh session. Reassemble the command with every arg safely re-quoted, since
# tmux hands the string to /bin/sh -c.
CMD="$(printf '%q ' "${CLAUDE[@]}")"
for a in "$@"; do CMD+=" $(printf '%q' "$a")"; done

if [ "$DETACH" = 0 ]; then
    exec tmux new-session -s "$SESSION" "$CMD"
fi

# ---- detached spawn -------------------------------------------------------
SESSIONS_DIR="$HOME/.claude/sessions"

# tmux's #{pane_pid} is the pane's TOP process, which is only claude if every
# wrapper exec'd through. /bin/sh does not always take that optimisation, and
# when it doesn't the pane pid is a surviving `sh -c` with claude as its CHILD —
# so a state file read at the pane pid never exists and an ARMED session reads
# as unarmed. Walk down to the first descendant that owns a state file.
# (Same logic as lunate_claude_ensure's claude_pid(); see the detailed setup doc.)
claude_pid() {
    local queue="$1" next p
    while [ -n "${queue// /}" ]; do
        next=""
        for p in $queue; do
            [ -f "$SESSIONS_DIR/$p.json" ] && { printf '%s' "$p"; return 0; }
            next="$next $(pgrep -P "$p" 2>/dev/null | tr '\n' ' ')"
        done
        queue="$next"
    done
    printf '%s' "$1"
}

tmux new-session -d -s "$SESSION" "$CMD"

# Since v2.1.215 the --remote-control flag arms the bridge on its own within a
# few seconds, even detached (#30447). Poll rather than sleep a flat 30s, and
# deliberately do NOT send `/remote-control` if it times out: that command
# TOGGLES, so nudging a session that armed late would switch a LIVE bridge off.
LINK="" ; PID=""
for _ in $(seq 1 30); do
    sleep 1
    PID="$(claude_pid "$(tmux list-panes -t "$SESSION" -F '#{pane_pid}' 2>/dev/null | head -1)")"
    [ -n "$PID" ] && [ -f "$SESSIONS_DIR/$PID.json" ] || continue
    LINK="$(grep -oE '"bridgeSessionId"[[:space:]]*:[[:space:]]*"session_[A-Za-z0-9]+"' \
        "$SESSIONS_DIR/$PID.json" 2>/dev/null | grep -oE 'session_[A-Za-z0-9]+' | head -1 || true)"
    [ -n "$LINK" ] && break
done

echo "session:  $SESSION"
echo "attach:   tmux attach -t $SESSION"
if [ -n "$LINK" ]; then
    echo "link:     https://claude.ai/code/$LINK"
else
    echo "link:     NOT ARMED after 30s — the process is up but the phone can't"
    echo "          reach it. Look at it first: tmux attach -t $SESSION"
    echo "          Most likely the trust prompt (\"Is this a project you"
    echo "          trust?\") for $(pwd) — a detached session has nobody to"
    echo "          answer it and waits forever. Accept it once in an attached"
    echo "          session, or set hasTrustDialogAccepted for that directory"
    echo "          in ~/.claude.json. Do NOT type /remote-control at it."
    exit 1
fi
